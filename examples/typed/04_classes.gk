/**
 * 04_classes.gk — classes, new expressions, and inheritance in gecko, typed
 * edition.
 *
 * This is the fully typed counterpart of examples/dynamic/04_classes.gk.
 * Class bodies and inheritance are unchanged; the difference is that this
 * project declares "type": "typed", so `new X(...)` is assigned to a
 * declared `*X` variable instead of relying on the dynamic
 * declare-or-assign rule.
 *
 * Run from this directory:
 *   ../../bin/gecko run 04_classes.gk
 */

package main

class Greeter() {
	constructor(name: string) {
		this.name = name
	}
	greet(): string {
		return "hi " + this.name
	}
	// Methods without a result type return nothing.
	loud() {
		println(this.greet() + "!")
	}
	// Fields can be set from any method, not just the constructor.
	setName(newName: string) {
		this.name = newName
	}
}

class Counter() {
	constructor() {
		this.count = 0
	}
	inc() {
		this.count = this.count + 1
	}
	value(): int {
		return this.count
	}
}

// A class without a constructor can still be allocated with new.
class Tag() {
	describe(): string {
		return "just a tag"
	}
}

// Animal is the base class used by the inheritance examples below.
class Animal {
	constructor(name: string) {
		this.name = name
	}
	speak(): string {
		return "animal " + this.name
	}
	loud(): string {
		return this.speak() + "!"
	}
	rename(newName: string) {
		this.name = newName
	}
}

// Dog extends Animal: it adds its own `breed` field, overrides speak(),
// and can still reuse the promoted loud()/rename() methods.
class Dog extends Animal {
	constructor(name: string, breed: string) {
		super(name)
		this.breed = breed
	}
	speak(): string {
		return "woof " + this.name
	}
	// super.loud() calls the base method; super.name reads the base field.
	parentLoud(): string {
		return super.loud() + " (from " + super.name + ")"
	}
}

// Three levels: Puppy extends Dog extends Animal. super takes a method
// from the immediate base.
class Puppy extends Dog {
	constructor(name: string, breed: string, tag: string) {
		super(name, breed)
		this.tag = tag
	}
	speak(): string {
		return super.speak() + " (puppy " + this.tag + ")"
	}
}

func main() {
	// new calls the constructor with the given arguments.
	var g: *Greeter = new Greeter("Ana")
	g.loud()

	// Instance methods can mutate the implicitly-created fields.
	g.setName("Bia")
	g.loud()

	// Classes with state: every new creates a fresh instance.
	var c: *Counter = new Counter()
	c.inc()
	c.inc()
	c.inc()
	println("counter:", c.value())

	var d: *Counter = new Counter()
	println("fresh counter:", d.value())

	// Constructing a class without a constructor.
	var t: *Tag = new Tag()
	println(t.describe())

	// Inheritance: base fields and methods are promoted.
	var a: *Animal = new Animal("generic")
	println(a.speak())

	var dog: *Dog = new Dog("Rex", "poodle")
	println(dog.speak())
	println(dog.loud())
	println(dog.parentLoud())

	// Promoted base methods mutate the promoted base field.
	dog.rename("Fido")
	println(dog.speak())

	var p: *Puppy = new Puppy("Pip", "beagle", "T1")
	println(p.speak())
	println(p.parentLoud())
	println(p.breed, p.tag)
}
