/**
 * 06_null.gk — the gecko null literal, typed edition.
 *
 * This is the fully typed counterpart of examples/dynamic/06_null.gk.
 * The dynamic edition compares values against null directly
 * (`x == null`); typed mode requires the comparison to be valid for the
 * declared type, so every null compared here is a nilable one (a pointer,
 * slice, map, channel, func or any).
 * A null pointer is also falsy, so a pointer can be used directly as the
 * condition of `?:`.
 *
 * Run from this directory:
 *   ../../bin/gecko run 06_null.gk
 */

package main

func describePtr(p: *string): string {
	if (p == null) {
		return "null pointer"
	}
	return "points at " + *p
}

func main() {
	// Comparing against null.
	var p: *int = null
	println("p == null:", p == null)
	println("p != null:", p != null)

	// Assigning null to every nilable type.
	var sl: []int = null
	var m: map[string]int = null
	var ch: chan int = null
	var fn: func() = null
	var itf: any = null
	println(sl, m, ch, fn, itf)

	// Resetting an existing variable to null.
	var word: string = "gecko"
	var ptr: *string = &word
	println("before:", describePtr(ptr))
	ptr = null
	println("after:", describePtr(ptr))

	// null as a function argument and result.
	println(describePtr(null))
	println(empty() == null)

	// A pointer is falsy when it is null, so it can be used directly as the
	// condition of `?:` -- the JavaScript `user ? user.name : "anon"` idiom.
	// Only the selected branch is evaluated, so *ptr is never dereferenced
	// while ptr is null.
	ptr = &word
	println("ptr:", ptr ? *ptr : "ptr is null")
	ptr = null
	println("ptr:", ptr ? *ptr : "ptr is null")
	println("empty:", empty() ? "has a box" : "no box")
}

class Box() {
	constructor(value: string) {
		this.value = value
	}
}

// Returning null.
func empty(): *Box {
	return null
}