/**
 * 05_exports.gk — the gecko export keyword, typed edition.
 *
 * This is the fully typed counterpart of examples/dynamic/05_exports.gk.
 * Visibility rules are identical; the only change is the explicit `*Person`
 * declaration for the imported class, because this project declares
 * "type": "typed" and cannot rely on declare-or-assign.
 *
 * The package is imported with the gecko "@" prefix below. The plain Go form
 * ("exportlib") still means the same package, and a relative path may name a
 * single file instead of a directory — `import { greet } from "./lib"`
 * or `from "./lib.gk"` would load just examples/typed/exportlib/lib.gk
 * as its own package, where a directory always wins over a same-named file.
 *
 * Run from this directory:
 *   ../../bin/gecko run 05_exports.gk
 */

package main

import "@exportlib"

func main() {
	// Exported lowercase func and var.
	println(exportlib.greet("Ana"))
	println(exportlib.greeting)

	// Exported const.
	println("version", exportlib.version)

	// Shortcut `export upper` re-exports the `upper` declaration.
	println(exportlib.upper("wow"))

	// List form `export {myMax, version}` exports both names.
	println("myMax", exportlib.myMax)

	// Classes: the class itself is exported; its fields and methods are
	// reachable regardless of capitalization. Qualified `new` works.
	var p: *exportlib.Person = new exportlib.Person("Bia")
	println(p.name)
	println(p.Loud())

	// These do NOT compile: the names exist but are private.
	// println(exportlib.PrivateGreeting("x")) // undefined: exportlib.PrivateGreeting
	// println(exportlib.SecretGreeting)       // undefined: exportlib.SecretGreeting
	// _ = new exportlib.Secret()              // undefined: exportlib.Secret
}