/**
 * 12_interfaces.gk — structural interfaces, typed edition.
 *
 * This is the fully typed counterpart of examples/dynamic/12_interfaces.gk.
 * Interface satisfaction is structural in both modes; the typed edition
 * only writes out the pointer types of the constructed classes, because
 * declare-or-assign is not available in a "typed" project.
 *
 * Run from this directory:
 *   ../../bin/gecko run 12_interfaces.gk
 */

package main

// Shape describes anything that knows its name and can compute its area.
interface Shape {
	name: string
	area(): float64
}

class Rectangle {
	constructor(name: string, width: float64, height: float64) {
		this.name = name
		this.width = width
		this.height = height
	}
	area(): float64 {
		return this.width * this.height
	}
}

class Circle {
	constructor(name: string, radius: float64) {
		this.name = name
		this.radius = radius
	}
	area(): float64 {
		return 3.14159 * this.radius * this.radius
	}
}

// Shapes with all the right methods but a wrong field type do not
// satisfy the interface: `name` is an int here, not a string.
class OddShape {
	constructor() {
		this.name = 42
	}
	area(): float64 {
		return 0
	}
}

func printShape(s: Shape) {
	println(s.name, "area:", s.area())
}

func main() {
	var r: *Rectangle = new Rectangle("square", 4, 5)
	var c: *Circle = new Circle("wheel", 2)

	printShape(r)
	printShape(c)

	// A value of interface type can be reassigned to any implementation.
	var s: Shape = r
	printShape(s)
	s = c
	printShape(s)
}
