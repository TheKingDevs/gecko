package main

func add(x: int, y: int): int {
	return x + y
}

func main() {
	x = 0
	var n: int = 5
	if (x != 0) {
		println("if")
	} else {
		println("else")
	}
	for (i = 0; i < 3; i++) {
		println("for")
	}
	items = []int{1}
	for (i = range items) {
		println("range", i)
	}
	for (i, v = range items) {
		println("two", i, v)
	}
	for (x < 3) {
		x++
	}
	for (;;) {
	}
	while (x < 3) {
		x++
	}
	while () {
	}
	switch (x) {
	case 0:
		println("tag")
	}
	switch (i = 0; i) {
	case 0:
		println("init")
	}
	var v: any
	switch (t = v.(type)) {
	case int:
		println("type", t)
	}
}

class Animal() {
	constructor(name: string) {
		this.name = name
	}
	speak(): string {
		return "animal " + this.name
	}
}

// The formatter drops the optional parentheses on the class and prints the
// extends clause; super is left untouched (no rewriting in go/parser).
class Dog extends Animal {
	constructor(name: string, breed: string) {
		super(name)
		this.breed = breed
	}
	speak(): string {
		return "woof " + this.name
	}
}

class NoParens {
	constructor() {
	}
}

// gecko try/catch/finally and throw.
func guard() {
	try {
		throw "boom"
	} catch (e) {
		println(e)
	} finally {
		println("done")
	}
	try {
		risky()
	} finally {
		cleanup()
	}
	try {
		risky()
	} catch {
		println("bare")
	}
}

