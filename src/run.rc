rfork e

if(! test -f ../bin/gecko){
	echo 'run.rc must be run from $GKROOT/src after installing cmd/go' >[1=2]
	exit wrongdir
}

GKENV=off
eval `{../bin/gecko tool dist env}

GKPATH=/nonexist-gopath
exec ../bin/gecko tool dist test -rebuild $*
